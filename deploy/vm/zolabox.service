[Unit]
Description=Zolabox — pile ZolaOS (appliance client)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/zolaos/deploy/zolabox
# Ne démarre que si la box est configurée (identité renseignée par install.sh).
ExecCondition=/usr/bin/test -f /opt/zolaos/deploy/zolabox/.env
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
