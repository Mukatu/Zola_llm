# ============================================================================
# Zolabox — configuration de l'appliance client. Copier en `.env` et remplir.
# `./install.sh` génère les secrets manquants (marqués « AUTO ») s'ils sont vides.
# NE JAMAIS versionner le .env rempli.
# ============================================================================

APP_ENV=prod
ZOLAOS_VERSION=latest
# Domaine d'accès des utilisateurs de la box (LAN : box.client.local).
ZOLABOX_DOMAIN=box.client.local

# ===== Identité de la box + tunnel vers le Cortex (fournis par Polaris) =====
# À récupérer au provisioning (cockpit Zolacortex → fiche client → « Provisionner »).
ZOLAOS_BOX_TENANT_ID=            # UUID du tenant client
ZOLAOS_BOX_CREDENTIAL=          # credential zbx_… (affiché une seule fois)
TUNNEL_CORTEX_URL=wss://cortex.polaris.cg/v1/tunnel/connect

# ===== Modèle local (8B) =====
LLM_MODEL_BRIGADE=llama3:8b
LLM_MODEL_ROUTER=llama3:8b
# Le box n'a pas le 70B : « réponse approfondie » retombe sur le 8B local.
LLM_MODEL_CORE=llama3:8b
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# ===== Secrets (AUTO : générés par install.sh si vides) =====
JWT_SECRET=                     # AUTO
API_KEY_PEPPER=                 # AUTO
ENCRYPTION_KEY_AUDIT=           # AUTO
POSTGRES_PASSWORD_MIGRATIONS=   # AUTO
POSTGRES_PASSWORD_APP=          # AUTO
POSTGRES_PASSWORD_HEALTH=       # AUTO
POSTGRES_PASSWORD_LEGAL=        # AUTO
POSTGRES_PASSWORD_ERP=          # AUTO
POSTGRES_PASSWORD_CODE=         # AUTO
POSTGRES_PASSWORD_AUDIT_W=      # AUTO
POSTGRES_PASSWORD_AUDIT_R=      # AUTO
REDIS_PASSWORD=                 # AUTO
MINIO_ROOT_USER=zolabox_minio
MINIO_ROOT_PASSWORD=            # AUTO
MINIO_BUCKET_DEFAULT=zolaos
MINIO_SECURE=false

# ===== Auth (cookies de prod : HTTPS obligatoire) =====
AUTH_COOKIE_SECURE=true

# ===== CORS (origine web de la box) =====
CORS_ORIGINS=https://box.client.local
