# ============================================================================
# Zolabox — configuration de l'appliance client. Copier en `.env` et remplir.
# `./install.sh` génère les secrets vides de la section « Secrets ».
# NE JAMAIS versionner le .env rempli.
#
# IMPORTANT — ne PAS mettre de commentaire « inline » après une valeur
# (ex. `KEY=valeur   # note`) : Docker Compose ne le retire PAS et l'inclurait
# dans la valeur. Toutes les notes sont sur des lignes de commentaire dédiées ;
# les valeurs restent seules après le `=`.
# ============================================================================

APP_ENV=prod
ZOLAOS_VERSION=latest

# Domaine d'accès des utilisateurs de la box (LAN : box.client.local).
ZOLABOX_DOMAIN=box.client.local

# ===== Identité de la box + tunnel vers le Cortex (fournis par Polaris) =====
# À récupérer au provisioning (cockpit Zolacortex → fiche client → « Provisionner »).
#   ZOLAOS_BOX_TENANT_ID  : UUID du tenant client.
#   ZOLAOS_BOX_CREDENTIAL : credential zbx_… (affiché une seule fois).
ZOLAOS_BOX_TENANT_ID=
ZOLAOS_BOX_CREDENTIAL=
# URL du tunnel = domaine TUNNEL du Cortex (CORTEX_TUNNEL_DOMAIN, porteur du mTLS),
# et NON le domaine cockpit (CORTEX_DOMAIN). Remplacer par le domaine réel du cortex.
TUNNEL_CORTEX_URL=wss://tunnel.polaris.cg/v1/tunnel/connect

# ===== mTLS du tunnel : certificat CLIENT de la box (signé par la CA Polaris) =====
# Émis côté Cortex : ./pki/issue_box_cert.sh <tenant_id> → box_<id>.crt / box_<id>.key.
# Copier les deux fichiers dans ./certs/box.crt et ./certs/box.key sur CE serveur
# (dossier monté en lecture seule dans le conteneur app via ./certs:/certs:ro).
# Pour ACTIVER le mTLS, renseigner les deux chemins (chemins DANS le conteneur) :
#   TUNNEL_CLIENT_CERT_PATH=/certs/box.crt
#   TUNNEL_CLIENT_KEY_PATH=/certs/box.key
# Laissés vides = tunnel sans certificat client (couche mTLS de transport inactive
# → non recommandé en production ; install.sh émet un avertissement).
TUNNEL_CLIENT_CERT_PATH=
TUNNEL_CLIENT_KEY_PATH=

# ===== Modèle local (8B) — le box n'a pas le 70B =====
LLM_MODEL_BRIGADE=llama3:8b
LLM_MODEL_ROUTER=llama3:8b
# « Réponse approfondie » retombe sur le 8B local (pas de 70B côté box).
LLM_MODEL_CORE=llama3:8b
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# ===== Secrets (vides → générés par install.sh) =====
JWT_SECRET=
API_KEY_PEPPER=
ENCRYPTION_KEY_AUDIT=
POSTGRES_PASSWORD_MIGRATIONS=
POSTGRES_PASSWORD_APP=
POSTGRES_PASSWORD_HEALTH=
POSTGRES_PASSWORD_LEGAL=
POSTGRES_PASSWORD_ERP=
POSTGRES_PASSWORD_CODE=
POSTGRES_PASSWORD_AUDIT_W=
POSTGRES_PASSWORD_AUDIT_R=
REDIS_PASSWORD=
MINIO_ROOT_USER=zolabox_minio
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_DEFAULT=zolaos
MINIO_SECURE=false

# ===== Supervision (profil « monitoring », opt-in) =====
# Mot de passe admin Grafana (vide → généré par install.sh ; sinon le compose
# retombe silencieusement sur « admin »).
GF_ADMIN_PASSWORD=

# ===== Entitlement des modules (distribution signée par Polaris) =====
# Contrôle quels modules sont montés (cf. docs/LICENSING.md). Défaut : désactivé
# (tous les modules montés). Pour l'appliquer : passer ENTITLEMENT_ENFORCED=true,
# fournir la clé publique Polaris (PEM) et une licence signée (JWT inline prioritaire,
# sinon un fichier de licence).
ENTITLEMENT_ENFORCED=false
ENTITLEMENT_PUBLIC_KEY=
ENTITLEMENT_LICENSE_JWT=
ENTITLEMENT_LICENSE_FILE=
ENTITLEMENT_REFRESH_SECONDS=3600

# ===== Auth (cookies de prod : HTTPS obligatoire) =====
AUTH_COOKIE_SECURE=true

# ===== CORS (origine web de la box) =====
CORS_ORIGINS=https://box.client.local
