# ============================================================================
# Zolacortex — configuration du cortex Polaris. Copier en `.env` et remplir.
# `./install.sh` génère les secrets marqués « AUTO » s'ils sont vides.
# NE JAMAIS versionner le .env rempli.
# ============================================================================

APP_ENV=prod
ZOLAOS_VERSION=latest

# ===== Domaines (Caddy gère les certificats) =====
CORTEX_DOMAIN=cortex.polaris.cg          # cockpit + API
CORTEX_TUNNEL_DOMAIN=tunnel.polaris.cg   # entrée des tunnels box (mTLS)

# ===== Modèles (cortex : routeur 8B + cœur 70B) =====
LLM_MODEL_ROUTER=llama3:8b
LLM_MODEL_BRIGADE=llama3:8b
LLM_MODEL_CORE=llama3:70b
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# ===== Tunnel mTLS =====
# Exigence du certificat client : gérée par le compose (TUNNEL_REQUIRE_CLIENT_CERT=true).
# La CA Polaris (pki/certs/polaris-ca.crt) est générée par pki/issue_box_cert.sh.
TUNNEL_CLIENT_CERT_CN_HEADER=x-client-cert-cn

# ===== Secrets (AUTO : générés par install.sh si vides) =====
JWT_SECRET=                     # AUTO
API_KEY_PEPPER=                 # AUTO
ENCRYPTION_KEY_AUDIT=           # AUTO
POSTGRES_PASSWORD_MIGRATIONS=   # AUTO
POSTGRES_PASSWORD_APP=          # AUTO
POSTGRES_PASSWORD_HEALTH=       # AUTO
POSTGRES_PASSWORD_LEGAL=        # AUTO
POSTGRES_PASSWORD_ERP=          # AUTO
POSTGRES_PASSWORD_CODE=         # AUTO
POSTGRES_PASSWORD_AUDIT_W=      # AUTO
POSTGRES_PASSWORD_AUDIT_R=      # AUTO
REDIS_PASSWORD=                 # AUTO
MINIO_ROOT_USER=zolacortex_minio
MINIO_ROOT_PASSWORD=            # AUTO
MINIO_BUCKET_DEFAULT=zolaos
MINIO_SECURE=false

# ===== Auth (cookies prod : HTTPS obligatoire) =====
AUTH_COOKIE_SECURE=true
CORS_ORIGINS=https://cortex.polaris.cg
