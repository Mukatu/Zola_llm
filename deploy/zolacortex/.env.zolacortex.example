# ============================================================================
# Zolacortex — configuration du cortex Polaris. Copier en `.env` et remplir.
# `./install.sh` génère les secrets vides. NE JAMAIS versionner le .env rempli.
#
# IMPORTANT — ne PAS mettre de commentaire « inline » après une valeur : Docker
# Compose ne le retire pas et l'inclurait dans la valeur. Notes sur des lignes
# dédiées ; les valeurs restent seules après le `=`.
# ============================================================================

APP_ENV=prod
ZOLAOS_VERSION=latest

# ===== Domaines (Caddy gère les certificats) =====
#   CORTEX_DOMAIN        : cockpit + API (HTTPS).
#   CORTEX_TUNNEL_DOMAIN : entrée des tunnels box (mTLS).
CORTEX_DOMAIN=cortex.polaris.cg
CORTEX_TUNNEL_DOMAIN=tunnel.polaris.cg

# ===== Modèles (cortex : routeur 8B + cœur 70B) =====
LLM_MODEL_ROUTER=llama3:8b
LLM_MODEL_BRIGADE=llama3:8b
LLM_MODEL_CORE=llama3:70b
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# ===== Tunnel mTLS =====
# L'exigence du certificat client est fixée par le compose (TUNNEL_REQUIRE_CLIENT_CERT=true).
# La CA Polaris (pki/certs/polaris-ca.crt) est créée par pki/issue_box_cert.sh.
TUNNEL_CLIENT_CERT_CN_HEADER=x-client-cert-cn

# ===== Secrets (vides → générés par install.sh) =====
JWT_SECRET=
API_KEY_PEPPER=
ENCRYPTION_KEY_AUDIT=
POSTGRES_PASSWORD_MIGRATIONS=
POSTGRES_PASSWORD_APP=
POSTGRES_PASSWORD_HEALTH=
POSTGRES_PASSWORD_LEGAL=
POSTGRES_PASSWORD_ERP=
POSTGRES_PASSWORD_CODE=
POSTGRES_PASSWORD_AUDIT_W=
POSTGRES_PASSWORD_AUDIT_R=
REDIS_PASSWORD=
MINIO_ROOT_USER=zolacortex_minio
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_DEFAULT=zolaos
MINIO_SECURE=false

# ===== Supervision (profil « monitoring », opt-in) =====
# Mot de passe admin Grafana (vide → généré par install.sh ; sinon repli « admin »).
GF_ADMIN_PASSWORD=

# ===== Auth (cookies prod : HTTPS obligatoire) =====
AUTH_COOKIE_SECURE=true
CORS_ORIGINS=https://cortex.polaris.cg
